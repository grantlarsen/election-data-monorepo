# Local development only. Copy this file to .env and change the password.
POSTGRES_DB=electoral
POSTGRES_USER=electoral_user
POSTGRES_PASSWORD=replace_with_a_long_random_local_password
POSTGRES_PORT=5432

# One API process refreshes the provisional Senate cache after 24 hours.
# Set to 0 when an external scheduler owns refreshes instead.
SENATE_RESULTS_AUTO_REFRESH=1

# Daily provisional House results, using the same durable data volume.
HOUSE_RESULTS_AUTO_REFRESH=1
